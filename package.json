{
  "name": "@packwarden-dev/thunderstore-mcp",
  "version": "0.1.0",
  "description": "PackWarden: MCP server for Thunderstore mod packs (search, dependency resolution, pack health, r2modman export). Not affiliated with Thunderstore.",
  "main": "dist/main.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:http": "node dist/main.js --http",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "js-yaml": "^5.4.3",
    "jszip": "^3.10.2",
    "stream-json": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/stream-json": "^1.7.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "packwarden-thunderstore-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "private": false,
  "engines": {
    "node": ">=18.17"
  },
  "mcpName": "io.github.packwarden-dev/packwarden",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/packwarden-dev/packwarden.git"
  },
  "homepage": "https://github.com/packwarden-dev/packwarden",
  "bugs": {
    "email": "support@packwarden.dev"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "thunderstore",
    "mods",
    "r2modman",
    "modpack"
  ],
  "publishConfig": {
    "access": "public"
  }
}